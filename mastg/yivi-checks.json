{
 "_comment": "Our own checks that automate OWASP MASTG tests. These are not written or reviewed by OWASP. See README.md.",
 "checks": [
  {
   "id": "yivi-android-screen-lock-detection",
   "test": "MASTG-TEST-0247",
   "title": "Looks for a call to KeyguardManager.isDeviceSecure(). OWASP's rule for this test expects the service to be looked up by the name \"keyguard\"; the app looks it up by class, which that rule does not match.",
   "target": "apk",
   "engine": "regex",
   "mode": "present",
   "files": [
    "sources/**/*.java"
   ],
   "pattern": "\\.isDeviceSecure\\(\\)"
  },
  {
   "id": "yivi-android-insecure-tls-protocols",
   "test": "MASTG-TEST-0217",
   "title": "A finding is code that asks for SSL, TLS 1.0 or TLS 1.1 by name.",
   "target": "apk",
   "engine": "regex",
   "mode": "absent",
   "files": [
    "sources/**/*.java"
   ],
   "pattern": "SSLContext\\.getInstance\\(\\s*\"(SSL|SSLv2|SSLv3|TLSv1|TLSv1\\.1)\""
  },
  {
   "id": "yivi-android-cleartext-configuration",
   "test": "MASTG-TEST-0235",
   "title": "A finding is a manifest or network security configuration that allows cleartext traffic.",
   "target": "apk",
   "engine": "regex",
   "mode": "absent",
   "files": [
    "resources/AndroidManifest.xml",
    "resources/res/xml/*.xml"
   ],
   "pattern": "(usesCleartextTraffic|cleartextTrafficPermitted)=\"true\""
  },
  {
   "id": "yivi-android-min-sdk-trusts-user-cas",
   "test": "MASTG-TEST-0285",
